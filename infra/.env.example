# Copy to the repo-root .env and fill in. These are self-hosted, you pick them.
# The compose file and dbt profiles.yml both read these names.

# MinIO Bronze (root credentials, also dbt-duckdb httpfs S3 keys)
MINIO_KEY=changeme-minio-user
MINIO_SECRET=changeme-minio-password

# Postgres serving/operational store (the CONTAINER postgres, VPS-portable)
POSTGRES_USER=changeme-pg-user
POSTGRES_PASSWORD=changeme-pg-password
# host-published port. Set 5433 if a native PG already owns 5432, else 5432.
POSTGRES_PORT=5432

# Prefect Cloud (Stage 2 — worker auth, not used by Stage 1)
PREFECT_API_KEY=
