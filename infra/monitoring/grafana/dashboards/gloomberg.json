{
  "uid": "gloomberg-ops",
  "title": "Gloomberg Terminal ops",
  "description": "API health, Prefect pipeline runs, LLM providers and quality gates.",
  "tags": [
    "gloomberg"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "API",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "API up",
      "description": "1 when Prometheus reached /metrics on its last scrape.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "up{job=\"gloomberg_api\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "fixed"
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "API request rate",
      "description": "Requests per second by route template.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 10,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "sum by (route) (rate(gloomberg_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "API 5xx error rate",
      "description": "Share of requests that ended in a 5xx.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 10,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "sum(rate(gloomberg_http_requests_total{status_class=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(gloomberg_http_requests_total[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx share",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "API p95 latency",
      "description": "95th percentile request duration by route.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(gloomberg_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "title": "Pipeline (Prefect via Pushgateway)",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Latest run per flow",
      "description": "The most recent finished run of each flow and how it ended.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "topk by (flow) (1, gloomberg_pipeline_last_run_finished_timestamp_seconds) * 1000",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "SUCCESS": {
                        "color": "green",
                        "index": 0
                      },
                      "PARTIAL": {
                        "color": "orange",
                        "index": 1
                      },
                      "DEGRADED": {
                        "color": "orange",
                        "index": 2
                      },
                      "FAILED": {
                        "color": "red",
                        "index": 3
                      },
                      "SKIPPED": {
                        "color": "text",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "displayName",
                "value": "finished"
              }
            ]
          }
        ]
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "flow": 0,
              "status": 1,
              "Value": 2
            }
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Time since last SUCCESS",
      "description": "How long ago each flow last ended with status SUCCESS.",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "time() - gloomberg_pipeline_last_run_finished_timestamp_seconds{status=\"SUCCESS\"}",
          "legendFormat": "{{flow}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Runs in range by flow and status",
      "description": "Finished runs in the selected time range.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "sum by (flow, status) (changes(gloomberg_pipeline_last_run_finished_timestamp_seconds[$__range]))",
          "legendFormat": "{{flow}} {{status}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Pipeline duration",
      "description": "Duration of the latest run, per flow and status.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "gloomberg_pipeline_last_run_duration_seconds",
          "legendFormat": "{{flow}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "stepAfter",
            "showPoints": "always",
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Records processed",
      "description": "Rows each stage handled in the latest run.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "gloomberg_pipeline_records_processed",
          "legendFormat": "{{flow}} {{stage}} ({{status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "stepAfter",
            "showPoints": "always",
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "stat",
      "title": "Records rejected (quarantined)",
      "description": "Rows the staging checks quarantined in the latest run.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "gloomberg_pipeline_records_rejected",
          "legendFormat": "{{flow}} {{stage}} ({{status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "LLM providers and quality gates",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "LLM requests by outcome",
      "description": "Provider calls per minute, split by provider and outcome.",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "sum by (provider, outcome) (rate(gloomberg_llm_requests_total[15m])) * 60",
          "legendFormat": "{{provider}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "stat",
      "title": "LLM failure share (1h)",
      "description": "Share of each provider's calls that did not succeed.",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "sum by (provider) (increase(gloomberg_llm_requests_total{outcome!=\"success\"}[1h])) / clamp_min(sum by (provider) (increase(gloomberg_llm_requests_total[1h])), 1e-9)",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "LLM p95 latency",
      "description": "95th percentile provider call duration.",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(gloomberg_llm_request_duration_seconds_bucket[15m])))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Provider fallbacks in range",
      "description": "Times the ladder handed a request to the next provider.",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 47,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "sum by (from_provider, to_provider, reason) (increase(gloomberg_llm_fallbacks_total[$__range]))",
          "legendFormat": "{{from_provider}} to {{to_provider}} ({{reason}})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Quality gate drafts in range",
      "description": "Drafts graded by the deterministic gates.",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "sum by (objective, outcome) (increase(gloomberg_quality_gate_drafts_total[$__range]))",
          "legendFormat": "{{objective}} {{outcome}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Quality gate rejections by gate",
      "description": "Which hard gate rejected the drafts.",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "gloomberg-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 55,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gloomberg-prometheus"
          },
          "expr": "sum by (gate) (increase(gloomberg_quality_gate_failures_total[$__range]))",
          "legendFormat": "{{gate}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
