# copy to .env and fill in, never commit the real one
# plain KEY=value lines, no quotes, no export

# the public domain, no https in front
GLOOMBERG_DOMAIN=
GLOOMBERG_WEB_TERMINAL_ORIGIN=

# object store for bronze files
MINIO_KEY=
MINIO_SECRET=
MINIO_ENDPOINT=127.0.0.1:9000

# serving database, the dev box uses 5433, the vps uses 5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
GLOOMBERG_POSTGRES_DSN=

# operator token, both values must be the same
GLOOMBERG_API_TOKEN=
GLOOMBERG_ORCH_BACKEND_API_TOKEN=

# llm providers, gemini first and groq as the fallback
GOOGLE_AI_STUDIO_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=
GROQ_MODEL=

# tracing, leave empty to turn it off
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# proxy for idx fetches, leave the host empty to go direct
WEBSHARE_PROXY_HOST=
WEBSHARE_PROXY_PORT=
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# prefect cloud, only when not using the local server
PREFECT_API_KEY=

# bigquery analyst mirror, optional
BQ_PROJECT=
BQ_CREDENTIALS=
BQ_LOCATION=

# grafana login, only when monitoring is turned on
GRAFANA_ADMIN_PASSWORD=
